# Dev-only template. Do NOT commit real secrets.
# Production installer gets:
#   - VITE_* baked at CI build (Google / Supabase client)
#   - resources/publisher-config.env written in CI from GitHub secrets (storage)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_CALLBACK_URL=http://127.0.0.1:3847/auth/callback

STORAGE_PROVIDER=hybrid
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

HYBRID_STORAGE_PRIMARY_ENDPOINT=
HYBRID_STORAGE_PRIMARY_ACCESS_KEY=
HYBRID_STORAGE_PRIMARY_SECRET_KEY=
HYBRID_STORAGE_PRIMARY_BUCKET=
HYBRID_STORAGE_PRIMARY_REGION=us-east-1
